# ─────────────────────────────────────────────────────────────
# Kairo Invoice Lite — environment variables
# Only BETTER_AUTH_SECRET is required in production. `npm run dev`
# creates .env from this file and generates the secret for you.
# ─────────────────────────────────────────────────────────────

# Public URL of the app (no trailing slash). Used in invoice links and emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — a local SQLite file by default. In production use Turso:
#   DATABASE_URL=libsql://your-db.turso.io  and  DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# Auth — required in production. Generate with: npx @better-auth/cli secret
BETTER_AUTH_SECRET=
# OAuth (optional). Callback URLs: {APP_URL}/api/auth/callback/github and /google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email — Resend API key. Empty = emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM=Kairo Invoice Lite <onboarding@resend.dev>
